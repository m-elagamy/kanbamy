generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id
  email               String?   @unique
  name                String?
  hasCreatedBoardOnce Boolean   @default(false)
  isDemo              Boolean   @default(false)
  demoTokenHash       String?   @unique
  demoExpiresAt       DateTime?
  boards              Board[]
  createdAt           DateTime? @default(now())
  updatedAt           DateTime? @updatedAt

  @@index([isDemo, demoExpiresAt])
}

model Board {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  lastVisitedAt DateTime?
  title         String
  slug          String
  description   String?   @default("")
  order         Int
  columns       Column[]
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, order])
}

model Column {
  id        String   @id @default(cuid())
  status    String
  order     Int
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([boardId, order])
}

model Task {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  title           String
  description     String?  @default("")
  priority        Priority @default(medium)
  order           String   @db.Text
  columnId        String
  columnEnteredAt DateTime @default(now())
  column          Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@unique([columnId, order])
  @@index([columnEnteredAt])
  @@index([priority])
}

enum Priority {
  low
  medium
  high
}
